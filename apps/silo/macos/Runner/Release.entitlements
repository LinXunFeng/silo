<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Sandbox is deliberately OFF — see DebugProfile.entitlements for the
  reasoning. In short: a sandboxed $HOME points into the app's container, so
  the app can neither see ~/.lmstudio nor hard-link into it, which is the
  one thing Silo exists to do.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
